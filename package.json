{
  "name": "opencode-file-viewer",
  "version": "1.0.0",
  "description": "OpenCode TUI plugin: view PNG/JPEG/WebP/GIF/SVG, PDF, EPUB, PPTX/DOCX (via LibreOffice), Markdown, code, CSV and JSON inline in the terminal",
  "type": "module",
  "license": "MIT",
  "author": "Eddie Lau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddy-lau/opencode-file-viewer.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "viewer",
    "pdf",
    "pptx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./tui.js"
  },
  "scripts": {
    "smoke": "bun test/smoke.ts",
    "tui": "bun build.ts"
  },
  "dependencies": {
    "@opencode/plugin": "latest",
    "mupdf": "^1.28.1",
    "omggif": "^1.0.10"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.4",
    "@opentui/core": "^0.6.8",
    "@opentui/solid": "^0.6.8",
    "@types/bun": "^1.4.4",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "tree-sitter-wasms": "0.1.13"
  }
}
